    {
        "id": "2054e634f25e13e8",
        "type": "function",
        "z": "8f9b1e8e42cf78a6",
        "name": "mqtt translate",
        "func": "let raw_data = typeof msg.payload === \"object\" ? msg.payload : JSON.parse(msg.payload.toString());\nconst floor_str = env.get(\"FLOOR_ID\").toString().padStart(2, '0');\nconst room_num = raw_data.metadata.room;\n\nmsg.topic = `campus/b01/f${floor_str}/r${room_num}/telemetry`;\n\nmsg.payload = {\n    temperature: raw_data.sensors.temperature,\n    humidity: raw_data.sensors.humidity,\n    occupancy: raw_data.sensors.occupancy\n};\n\nreturn msg;",
