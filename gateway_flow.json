    {
        "id": "a1526858668bf32f",
        "type": "function",
        "z": "8f9b1e8e42cf78a6",
        "name": "init observers",
        "func": "const floor = parseInt(env.get(\"FLOOR_ID\"));\nconst engine_host = env.get(\"ENGINE_HOST\") || \"engine\";\nconst floor_str = floor.toString().padStart(2, '0');\n\nlet messages = [];\n\nfor (let i = 0; i < 10; i++) {\n    let slot = 11 + i;\n    let room_num = (floor * 100) + slot;\n\n    let port = 25000 + ((floor - 1) * 10) + i;\n\n    messages.push({\n        payload: \"\",\n        url: `coap://${engine_host}:${port}/f${floor_str}/r${room_num}/telemetry`,\n        method: \"OBSERVE\"\n    });\n}\n\nreturn [messages];",
        "outputs": 1,
        "timeout": 0,
