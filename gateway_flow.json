        "type": "function",
        "z": "8f9b1e8e42cf78a6",
        "name": "function 19",
        "func": "let sum = 0;\nlet count = msg.payload.length;\n\nmsg.payload.forEach(reading => {\n    sum += reading.temperature;\n})\n\nmsg.topic = `campus/b01/f${env.get(\"FLOOR_ID\").toString().padStart(2, '0')}/summary`;\nmsg.payload = { average_temp: (sum / count).toFixed(2) };\nreturn msg;",
