    {
        "id": "3e2d9c5dd3751e33",
        "type": "function",
        "z": "243020977b743f2f",
        "name": "command router",
        "func": "let parts = msg.topic.split(\"/\");\nlet floor = parseInt(parts[2].replace(\"f\", \"\"));\nlet room_num = parseInt(parts[3].replace(\"r\", \"\"));\n\nif (floor !== parseInt(env.get(\"FLOOR_ID\"))) return null;\n\nlet slot = room_num - (floor * 100);\n\nif (slot > 10) {\n    const engine_host = env.get(\"ENGINE_HOST\") || \"engine\";\n    let port_offset = ((floor - 1) * 10) + (slot - 11);\n    let port = 25000 + port_offset;\n\n    let command_data = JSON.parse(msg.payload);\n    let actuator = command_data.target || \"hvac\";\n    \n    msg.url = `coap://${engine_host}:${port}/f${parts[2]}/r${room_num}/actuators/${actuator}`;\n    msg.method = \"PUT\";\n    \n    msg.confirmable = true; \n    msg.payload = command_data.state;\n    \n    msg.responseTopic = `campus/b01/f${parts[2]}/r${room_num}/response`;\n    \n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
